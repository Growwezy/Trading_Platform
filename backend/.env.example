# Backend environment variables.
# Copy to .env and fill in real values — .env is gitignored, this file is not.
# Grouped by when each one is actually needed (see docs/PROGRESS.md "Next").

# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database (needed now — Phase 1 scaffolding) ────────────────────────
# NeonDB connection string, shared by both developers while building.
# TECH_STACK.md: same DATABASE_URL shape in dev (Neon) and prod (Dockerized Postgres) — only the value changes.
# Prisma convention: DATABASE_URL (pooled, via PgBouncer) for the running app,
# DIRECT_URL (unpooled) for `prisma migrate` — the pooler doesn't support the
# prepared statements migrations need.
DATABASE_URL=
DIRECT_URL=

# ── Redis (needed now — sessions, price cache/pub-sub) ─────────────────
# Local dev: runs via docker-compose, no external account needed.
REDIS_URL=redis://localhost:6379

# ── Sessions (needed now — Phase 1 auth) ────────────────────────────────
# Random long string used to sign the session cookie. Not a session secret store
# (that's Redis) — just the cookie-signing key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Tenant / domain resolution (needed now — Phase 1 tenant middleware) ─
# Local dev placeholder until a real platform domain is picked (OPEN_QUESTIONS.md #5, #9).
# e.g. demo.localhost, mapped via hosts file — swap for the real domain later.
PLATFORM_DOMAIN=localhost

# ── Market data (needed soon — Phase 3 trading engine / charts) ────────
# Binance: no key needed, public WebSocket.
TWELVE_DATA_API_KEY=

# ── File storage — Cloudinary (needed soon — Phase 2 KYC/deposit-proof uploads) ─
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email / OTP delivery (needed soon — Phase 1/2 sign-up + forgot-password OTP) ─
# Provider not yet decided (see conversation / OPEN_QUESTIONS.md). Fill in once picked.
# Example for Resend (simplest option):
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# ── Neon Object Storage (provisioned but NOT wired up — deliberately unused for now) ─
# `neon deploy` will append its own vars here (bucket name, endpoint, credentials) if you
# ran it with --services postgres,object-storage. Leave them as-is / ignore — Cloudinary
# is the active file-storage path. Neon's object storage is still beta; revisit only if
# we decide to consolidate later.

# ── Not needed yet (production only — AWS, S3, Cloudflare) ─────────────
# Left out on purpose. Add when Phase 1 reaches actual deployment.
